from typing import Any, Literal, TypedDict

class ActionResult(TypedDict, total=False):
    status: Literal["confirmed", "rejected", "stale_observation", "intention_unavailable", "unknown_outcome"]
    receipt: dict[str, Any]
    code: str
    message: str
    page: dict[str, Any] | None

class Observation:
    def data(self) -> dict[str, Any]: ...

class Session:
    @staticmethod
    def connect(address: str, token: str, actor: int) -> Session: ...
    def observe(self) -> Observation: ...
    def act(self, action: dict[str, Any], observation: Observation) -> ActionResult: ...
    def resume(self, observation: Observation) -> ActionResult: ...
    def cancel(self, observation: Observation) -> ActionResult: ...
    def advancement(self, input: str) -> ActionResult: ...
    def projectile_choices(self, observation: Observation, ability: str,
                           phase: dict[str, Any], offset: int) -> dict[str, Any] | None: ...
    def chart(self, observation: Observation,
              kind: Literal["monsters", "food", "magic", "mapping"]) -> dict[str, Any] | None: ...
    def close(self) -> None: ...
